# TinaCMS / Tina Cloud — copy to .env.local and fill in the token.
# Set BOTH of these in the Cloudflare Pages build environment as well.

# Public client ID of the Tina Cloud project (safe to expose)
NEXT_PUBLIC_TINA_CLIENT_ID=ac90b0e6-b455-4967-8517-30843f31d613

# Read-only content token from Tina Cloud (SECRET — never commit a real value)
TINA_TOKEN=
